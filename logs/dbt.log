WITH staging_data AS (
    SELECT * FROM `depi-graduation-project-489604`.`nyc_311_raw_data`.`stg_nyc_311_requests`
)

SELECT
    complaint_id,
    complaint_type,
    complaint_status,
    created_at,
    closed_at,
    -- حساب الفرق بالأيام بين تاريخ الإنشاء والإغلاق
    DATE_DIFF(DATE(closed_at), DATE(created_at), DAY) AS days_to_close,
    --The new test is for rush hour analysis----------------------------------------------
    -- 2. استخراج ساعة الذروة (0-23)
    EXTRACT(HOUR FROM created_at) AS creation_hour,
    
    -- 3. استخراج يوم الأسبوع (اسم اليوم)
    FORMAT_DATE('%A', DATE(created_at)) AS creation_day_name,
    
    -- 4. تصنيف الوقت (صباح، مساء، ليل)
    CASE 
        WHEN EXTRACT(HOUR FROM created_at) BETWEEN 6 AND 11 THEN 'Morning'
        WHEN EXTRACT(HOUR FROM created_at) BETWEEN 12 AND 17 THEN 'Afternoon'
        WHEN EXTRACT(HOUR FROM created_at) BETWEEN 18 AND 23 THEN 'Evening'
        ELSE 'Night'
    END AS time_period
    --The new test nds here-------------------------------------------------------------
FROM staging_data
-- سنركز فقط على الشكاوى التي تم إغلاقها بالفعل لنتمكن من الحساب
WHERE closed_at IS NOT NULL 
  AND complaint_status = 'Closed'
    );
  
